# Copy to .env and adjust. Never commit the real .env file.

# Set to 1 only for local development.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origin(s) allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set to 1 in production behind HTTPS.
DJANGO_SECURE_SSL_REDIRECT=0

# External services (all free, no API key needed by default).
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
PHOTON_BASE_URL=https://photon.komoot.io
# Identify this app to the free public services (their usage policies ask for it).
HTTP_USER_AGENT=WeatherAwareTruckRouting/1.0 (contact: your-email@example.com)

# Optional shared cache for production (e.g. redis://localhost:6379/0).
REDIS_URL=

# LOCAL DEVELOPMENT ONLY: lay a simulated moving storm over the fastest route to demonstrate the
# risk logic. Ignored unless DJANGO_DEBUG=1 (forced off in production). The UI shows a banner.
# WEATHER_SCENARIO=storm
# WEATHER_STORM_PEAK_MPH=42
